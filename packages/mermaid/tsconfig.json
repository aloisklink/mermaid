{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    "types": ["vitest/importMeta"]
  },
  "include": ["./src/**/*.ts", "./package.json", "./src/**/*.js"],
  // Test files are compiled in `tsconfig.eslint.json`
  "exclude": ["./src/**/*.spec.ts", "./src/**/*.spec.js", "**/__mocks__"],
  "references": [
    {
      "path": "../parser"
    }
  ]
}
