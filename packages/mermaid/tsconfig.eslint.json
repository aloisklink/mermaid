{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // needed for '../../.lintstagedrc.mjs' to be included in the project
    "rootDir": "../../",
    "outDir": "node_modules/.typescript",
    "composite": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "./src/**/*.spec.js", // test files
    "./src/**/*.spec.ts", // test files
    "./src/**/__mocks__", // mock files
    "./scripts",
    "./.lintstagedrc.mjs",
    "../../.lintstagedrc.mjs"
  ],
  "references": [
    {
      "path": "./tsconfig.json"
    }
  ]
}
