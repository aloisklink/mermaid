{
  // extend your base config to share compilerOptions, etc
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // ensure that nobody can accidentally use this config for a build
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "./.build/*.ts",
    "./.esbuild/*.ts",
    "./.vite/*.ts",
    "./tests",
    "./scripts",
    "./__mocks__",
    "./demos/dev",
    "./vite.config.ts",
    "./vitest.workspace.js",
    "eslint.config.js"
  ],
  "references": [
    {
      "path": "./tsconfig.json"
    },
    {
      "path": "./packages/mermaid/tsconfig.eslint.json"
    },
    {
      "path": "./cypress/tsconfig.json"
    }
  ]
}
