{
  // extend your base config to share compilerOptions, etc
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // ensure that nobody can accidentally use this config for a build
    "noEmit": true,
    "allowJs": true,
    // Seems to be required for importing `vite-plugin-istanbul` and `@rollup/plugin-typescript`
    // They're both "Masquerading as CJS", see https://arethetypeswrong.github.io/?p=vite-plugin-istanbul%407.2.1
    "moduleResolution": "bundler",
    "module": "es2022",
    "target": "es2022"
  },
  "include": [
    "./.build/*.ts",
    "./.esbuild/*.ts",
    "./.vite/*.ts",
    "./tests",
    "./scripts",
    "./__mocks__",
    "./demos/dev",
    "./vite.config.ts",
    "./vitest.workspace.js",
    "eslint.config.js"
  ],
  "references": [
    {
      "path": "./tsconfig.json"
    },
    {
      "path": "./packages/mermaid/tsconfig.eslint.json"
    },
    {
      "path": "./cypress/tsconfig.json"
    }
  ]
}
